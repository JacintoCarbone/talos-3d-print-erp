<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Talos" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#14171C</item>
        <item name="android:navigationBarColor">#14171C</item>
    </style>

    <style name="Theme.Talos.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_talos_brand</item>
        <item name="windowSplashScreenBackground">#14171C</item>
        <item name="postSplashScreenTheme">@style/Theme.Talos</item>
    </style>
</resources>
